# ContentForge Backend Configuration Example
APP_TITLE=ContentForge API
APP_DESCRIPTION=AI-Powered Multi-Format Content Transformation Platform
APP_VERSION=1.0.0

# Groq API Keys (Provides key rotation and fallback)
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here

# Groq LLM Settings
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2500
